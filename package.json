{
  "name": "loud",
  "version": "1.0.0",
  "private": true,
  "description": "Music visualizer that runs in the browser: mic, audio file or a built-in beat.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build && cp dist/index.html index.html",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:visual": "node tests/visual/compare.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "packageManager": "pnpm@10.33.0"
}
